# Copy to .env.local — never commit real values, never log them.
# Filled in per phase; blank until the phase that needs them.

# ── Phase 1+ · Supabase ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role lives ONLY in edge function secrets — never in apps/web:
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...

# ── Phase 4 · Milesight Development Platform ────────────────────
# Per-Application tokens are stored encrypted in the database, not here.
MDP_API_BASE_URL=

# ── Phase 6 · Notifications ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=

# ── Phase 7 · Stripe ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
